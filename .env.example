# OpportunityMiner Environment Configuration

# Optional: LLM provider for problem extraction (system falls back to heuristic extractor if unset)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: Reddit API credentials (system falls back to public .json / RSS feeds if unset)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=OpportunityMiner/0.1.0

# Optional: Product Hunt API token (falls back to RSS/Atom feeds if unset)
PRODUCTHUNT_TOKEN=

# Database Connection (defaults to local SQLite if unset)
DATABASE_URL=sqlite:///data/opportunity_miner.db
