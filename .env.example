# OpportunityMiner Environment Configuration — 100% FREE & OPEN-SOURCE
# All core features work OUT OF THE BOX with zero API keys via public feeds + heuristic extractor
# Uncomment only what you self-host — nothing requires a paid SaaS

# ── Paid LLM (optional, heuristic fallback if unset) ─────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── FREE OSS LOCAL LLM via Ollama (MIT, http://localhost:11434, no key) ──
# Install: curl -fsSL https://ollama.com/install.sh | sh && ollama pull mistral && ollama serve
# Models: mistral (7B Apache-2.0), phi4 (14B MIT), llama3.2 (2GB), qwen3 (Apache-2.0)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral
# USE_OLLAMA=1  # force local LLM even if gemini/openai also set

# ── Reddit (falls back to public .json / RSS feeds if unset) ───────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=OpportunityMiner/0.1.0

# ── GitHub (free PAT for 5k req/h, else 60/h unauth — still works) ─────────
GITHUB_TOKEN=

# ── Product Hunt (falls back to RSS/Atom feeds if unset) ───────────────────
PRODUCTHUNT_TOKEN=

# ── FREE OSS VECTOR STORE (all pip-install from pypi.org, github.com) ──────
# auto | sentence_transformers (Apache-2.0) | fastembed (MIT) | hash (zero-deps)
VECTOR_BACKEND=auto
VECTOR_MODEL=sentence-transformers/all-MiniLM-L6-v2  # Apache-2.0, 80MB, 384d
# Alternatives: BAAI/bge-m3 (MIT, 1024d), BAAI/bge-small-en-v1.5 (MIT, 384d), Qwen/Qwen3-Embedding-0.6B (Apache-2.0)
# FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
# CHROMA_PATH=data/vectors/chroma   # Chroma Apache-2.0 persistent
# QDRANT_PATH=data/vectors/qdrant   # Qdrant Apache-2.0 persistent
# QDRANT_URL=http://localhost:6333

# ── FREE OSS SERP (self-hosted, no paid SerpApi) ───────────────────────────
# docker run -p 7000:7000 karust/openserp serve          # MIT
# docker run -p 8080:8080 searxng/searxng:latest         # AGPL
SERP_PROVIDER=auto
OPENSERP_URL=http://localhost:7000
SEARXNG_URL=http://localhost:8080

# ── FREE OSS CRM (self-hosted, no HubSpot/Airtable cloud) ─────────────────
# docker run -p 3000:3000 baserow/baserow                # MIT
# docker run -p 8080:8080 nocodb/nocodb                  # AGPL
CRM_PROVIDER=auto
BASEROW_URL=http://localhost:3000
BASEROW_TOKEN=
BASEROW_TABLE_ID=
NOCODB_URL=
NOCODB_TOKEN=

# ── FREE OSS NOTIFICATIONS (Apprise MIT + ntfy Apache-2.0) ─────────────────
# pip install apprise (MIT) — then: tgram://bot_token/chat_id,discord://webhook
NOTIFY_URLS=
# ntfy: self-hosted binwiederhier/ntfy or free ntfy.sh
NTFY_TOPIC=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
GOTIFY_URL=
GOTIFY_TOKEN=

# ── Database (defaults to local SQLite if unset) ──────────────────────────
DATABASE_URL=sqlite:///data/opportunity_miner.db
